rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Deny everything by default.
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{uid} {
      // Users can read their own profile, or any profile belonging to the
      // same household (needed by control-gastos's NoAccessPage to show the
      // admin's name/email; only exposes uid/email/role/householdId, no
      // sensitive data).
      allow read: if request.auth != null
                  && (request.auth.uid == uid || isMember(resource.data.householdId));

      // Initial profile creation (sign-up / Google sign-in):
      // only allowed with role='member' and householdId=null so that
      // no client can bootstrap a privileged profile.
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.role == 'member'
                    && request.resource.data.householdId == null;

      // Client-side updates fall into two categories:
      //
      // 1. Regular profile edits — must not touch role or householdId.
      //
      // 2. Household assignment (createHousehold / joinHousehold) — only
      //    permitted when the user has no household yet (householdId == null).
      //    • role='admin' is allowed only when the target household was
      //      created by this user (createdBy == uid), preventing self-elevation
      //      to admin on someone else's household.
      //    • role='member' is allowed for any existing household, mirroring
      //      the joinHousehold flow.
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && (
                      // Normal profile edit — role and householdId unchanged.
                      !request.resource.data.diff(resource.data)
                          .affectedKeys().hasAny(['role', 'householdId'])
                      // Household assignment from a null state.
                      || (
                        resource.data.householdId == null
                        && request.resource.data.householdId != null
                        && exists(/databases/$(database)/documents/households/$(request.resource.data.householdId))
                        && (
                          // Becoming admin: only if this user created the household.
                          (
                            request.resource.data.role == 'admin'
                            && get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.createdBy == uid
                          )
                          // Becoming member: household must exist (invite-code
                          // validity is enforced in application logic).
                          || request.resource.data.role == 'member'
                        )
                      )
                    );

      // Admin-only: toggle canAccessGastos on another member's profile
      // (control-gastos's Settings > Members section). Additive to the
      // update rule above — Firestore ORs allow rules across statements
      // in the same match block, so this coexists with the self-only
      // rule rather than replacing it.
      allow update: if isAdmin(resource.data.householdId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['canAccessGastos']);
    }

    match /households/{householdId} {
      allow read: if isMember(householdId);
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAdmin(householdId);
    }

    // Invite-code lookup: invites/{CODE} -> { householdId }. Enables the
    // join-by-invite-code flow (households themselves are only readable by
    // members, so a joining user cannot query them by inviteCode).
    match /invites/{code} {
      // Direct get only — no list, so codes cannot be enumerated. Knowing
      // a code is what grants the lookup.
      allow get: if request.auth != null;
      allow list: if false;

      // Any member of the target household may publish/refresh its invite
      // doc (apps upsert it on sign-in), but only under the household's
      // real inviteCode and with no extra data.
      allow create, update: if isMember(request.resource.data.householdId)
                    && get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.inviteCode == code
                    && request.resource.data.keys().hasOnly(['householdId'])
                    && request.resource.data.householdId is string;

      allow delete: if isAdmin(resource.data.householdId);
    }

    match /households/{householdId}/people/{personId} {
      allow read: if isMember(householdId);
      allow create: if isMember(householdId) && isValidPerson(request.resource.data);
      allow update: if isMember(householdId)
                    && isValidPerson(request.resource.data)
                    && request.resource.data.id == resource.data.id;
      allow delete: if isMember(householdId);
    }

    match /households/{householdId}/chores/{choreId} {
      allow read: if isMember(householdId);
      allow create: if isMember(householdId) && isValidChore(request.resource.data);
      allow update: if isMember(householdId)
                    && isValidChore(request.resource.data)
                    && request.resource.data.id == resource.data.id;
      allow delete: if isMember(householdId);
    }

    // our-menu — weekly menu planning data lives as subcollections of
    // households/{householdId}/. grocery_lists uses the smart-grocery
    // GroceryList schema so that app can consume the generated lists.
    match /households/{householdId}/menu_ingredients/{ingredientId} {
      allow read: if isMember(householdId);
      allow create: if isMember(householdId) && isValidIngredient(request.resource.data);
      allow update: if isMember(householdId)
                    && isValidIngredient(request.resource.data)
                    && request.resource.data.id == resource.data.id;
      allow delete: if isMember(householdId);
    }

    match /households/{householdId}/menu_dishes/{dishId} {
      allow read: if isMember(householdId);
      allow create: if isMember(householdId) && isValidDish(request.resource.data);
      allow update: if isMember(householdId)
                    && isValidDish(request.resource.data)
                    && request.resource.data.id == resource.data.id;
      allow delete: if isMember(householdId);
    }

    match /households/{householdId}/menu_week_plans/{weekId} {
      allow read: if isMember(householdId);
      allow create: if isMember(householdId) && isValidWeekPlan(request.resource.data);
      allow update: if isMember(householdId)
                    && isValidWeekPlan(request.resource.data)
                    && request.resource.data.id == resource.data.id;
      allow delete: if isMember(householdId);
    }

    match /households/{householdId}/grocery_lists/{listId} {
      allow read: if isMember(householdId);
      allow create: if isMember(householdId) && isValidGroceryList(request.resource.data);
      allow update: if isMember(householdId)
                    && isValidGroceryList(request.resource.data)
                    && request.resource.data.id == resource.data.id;
      allow delete: if isMember(householdId);
    }

    // control-gastos — all gastos data lives as subcollections of
    // households/{householdId}/. Admin always has access regardless of
    // canAccessGastos (see hasGastosAccess).
    match /households/{householdId}/gastos_settings/{docId} {
      allow read, write: if hasGastosAccess(householdId);
    }
    match /households/{householdId}/gastos_categorias/{docId} {
      allow read, write: if hasGastosAccess(householdId);
    }
    match /households/{householdId}/gastos_conceptos/{docId} {
      allow read, write: if hasGastosAccess(householdId);
    }
    match /households/{householdId}/gastos_anuales/{docId} {
      allow read, write: if hasGastosAccess(householdId);
    }
    match /households/{householdId}/gastos_compras_meses/{docId} {
      allow read, write: if hasGastosAccess(householdId);
    }
    match /households/{householdId}/gastos_registros/{docId} {
      allow read, write: if hasGastosAccess(householdId);
    }
    match /households/{householdId}/gastos_detalle/{docId} {
      allow read, write: if hasGastosAccess(householdId);
    }
    match /households/{householdId}/gastos_negocios/{docId} {
      allow read, write: if hasGastosAccess(householdId);
    }

    function isMember(householdId) {
      return request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid))
               .data.householdId == householdId;
    }

    function isAdmin(householdId) {
      return isMember(householdId)
          && get(/databases/$(database)/documents/users/$(request.auth.uid))
               .data.role == 'admin';
    }

    function isValidPerson(data) {
      return data.keys().hasAll(['id', 'name'])
          && data.id is string
          && data.name is string;
    }

    function isValidChore(data) {
      return data.keys().hasAll(['id', 'title'])
          && data.id is string
          && data.title is string;
    }

    // our-menu validators
    function isValidIngredient(data) {
      return data.keys().hasAll(['id', 'name'])
          && data.id is string
          && data.name is string;
    }

    function isValidDish(data) {
      return data.keys().hasAll(['id', 'name', 'ingredients'])
          && data.id is string
          && data.name is string
          && data.ingredients is list;
    }

    function isValidWeekPlan(data) {
      return data.keys().hasAll(['id', 'weekStart', 'days'])
          && data.id is string
          && data.weekStart is string
          && data.days is map;
    }

    function isValidGroceryList(data) {
      return data.keys().hasAll(['id', 'title', 'items'])
          && data.id is string
          && data.title is string
          && data.items is list;
    }

    // control-gastos helpers
    function canAccessGastosFlag(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.canAccessGastos == true;
    }

    function hasGastosAccess(householdId) {
      return isMember(householdId) && (isAdmin(householdId) || canAccessGastosFlag(request.auth.uid));
    }
  }
}
